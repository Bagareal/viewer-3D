# Settings of the conversion server. Copy to /etc/step2glb-server.env and edit.
# Only PASSPHRASE is required; every other line shows the default value.
# The server does not start while PASSPHRASE is empty or still CHANGE_ME.

# Shared passphrase asked by the viewer (choose your own).
PASSPHRASE=CHANGE_ME

# Address to listen on. 127.0.0.1 = only this machine (use it behind a reverse proxy).
# Use 0.0.0.0 to be reachable from the network, or the machine's own address to listen on one interface only.
HOST=127.0.0.1

# Port to listen on.
PORT=8000

# Folder where uploads and converted files are kept (deleted automatically).
DATA_DIR=/var/lib/step2glb-server

# Folder with the Viewer 3D files, served at the same address as the API. Only index.html, css, js and vendor
# are served from it. Not set: the viewer folder next to this server is used. Set but empty: no viewer, API only.
# VIEWER_DIR=/opt/step2glb-server/app

# Largest STEP accepted, in MB.
MAX_FILE_MB=1024

# Size of each upload piece, in MB (keep it well under 100 for Cloudflare's free plan).
CHUNK_MB=50

# Jobs alive at the same time (uploading, waiting or converting).
MAX_ACTIVE_JOBS=5

# Hours a converted file is kept before it is deleted.
FILE_TTL_HOURS=2

# Hours after which a conversion is stopped.
JOB_TIMEOUT_HOURS=2

# Mesh quality: draft, normal or fine.
QUALITY=normal

# Addresses allowed to call the API from another website (comma separated).
# Leave empty when the viewer is served by this same server.
# CORS_ORIGINS=https://bagareal.github.io

# Set to 1 only behind a reverse proxy or tunnel you trust: reads the real client address from its headers.
# TRUST_PROXY=1

# Set to 1 to run with no passphrase (only on a network where everyone who can reach the server may use it).
# ALLOW_NO_PASSPHRASE=1
